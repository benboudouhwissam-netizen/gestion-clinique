<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="CENTER"
      style="-fx-background-color: #ecf0f1;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionclinique.controllers.AccueilController"
      stylesheets="@/css/clinique.css">

    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label fx:id="lblBienvenue" styleClass="label-title"/>

    <Separator/>

    <GridPane hgap="20" vgap="20" alignment="CENTER">
        <Label text="Gestion patients :" styleClass="label-field" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbPatients" promptText="Choisir patient" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

        <Label text="Actions :" styleClass="label-field" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbActions" promptText="Choisir action" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>
    </GridPane>

    <HBox spacing="20" alignment="CENTER">
        <Button text="EXÉCUTER" onAction="#executerAction" styleClass="button-primary" />
        <Button text="DÉCONNEXION" onAction="#deconnexion" styleClass="button-danger" />
    </HBox>

    <Label fx:id="lblStatut" style="-fx-text-fill: #7f8c8d;"/>
</VBox>