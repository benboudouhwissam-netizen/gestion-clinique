<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionclinique.controllers.InfirmierController"
      styleClass="root" stylesheets="@/css/clinique.css"
      style="-fx-padding: 20;">

    <Label text="CONSULTATION - CONSTANTES VITALES" styleClass="label-title"/>
    <Label fx:id="lblPatient" styleClass="label-subtitle"/>

    <Separator/>

    <GridPane hgap="10" vgap="10">
        <Label text="Tension (mmHg) :" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-field"/>
        <HBox GridPane.rowIndex="0" GridPane.columnIndex="1" spacing="5">
            <TextField fx:id="txtTensionSyst" promptText="Systolique" prefWidth="80"/>
            <Label text="/" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <TextField fx:id="txtTensionDiast" promptText="Diastolique" prefWidth="80"/>
        </HBox>

        <Label text="Glycémie (g/L) :" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-field"/>
        <TextField fx:id="txtGlycemie" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Ex: 1.05"/>

        <Label text="Température (°C) :" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-field"/>
        <TextField fx:id="txtTemperature" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Ex: 36.8"/>

        <Label text="Cas urgent :" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-field"/>
        <CheckBox fx:id="chkUrgent" GridPane.rowIndex="3" GridPane.columnIndex="1" text="⚡ URGENT" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
    </GridPane>

    <!-- Bloc diagnostic (lecture seule) -->
    <Label text="DIAGNOSTIC MÉDICAL (lecture seule)" styleClass="label-section"/>
    <TextArea fx:id="txtDiagnostic" editable="false" wrapText="true" prefHeight="100"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="ENREGISTRER CONSTANTES" onAction="#enregistrerConstantes" styleClass="button-success" />
        <Button text="RETOUR" onAction="#retourAccueil" styleClass="button-primary" />
    </HBox>
</VBox>