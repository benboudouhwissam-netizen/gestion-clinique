<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.gestionclinique.controllers.FileAttenteController"
      stylesheets="@/css/clinique.css"
      style="-fx-padding: 20;">

    <Label text="FILE D'ATTENTE - PRIORITÉ PATIENTS URGENTS" styleClass="label-title"/>

    <Separator/>

    <HBox spacing="10">
        <Label text="🔴 URGENT" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
        <Label text="🟢 NORMAL" style="-fx-text-fill: green; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="RAFRAÎCHIR" onAction="#rafraichirListe" styleClass="button-secondary"/>
    </HBox>

    <TableView fx:id="tableViewConsultations" prefHeight="400">
        <columns>
            <TableColumn text="Priorité" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="prioriteTexte" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Patient" prefWidth="200">
                <cellValueFactory>
                    <PropertyValueFactory property="patientNomComplet" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Date consultation" prefWidth="180">
                <cellValueFactory>
                    <PropertyValueFactory property="dateConsultationFormatee" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Tension" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="tensionFormatee" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Glycémie" prefWidth="80">
                <cellValueFactory>
                    <PropertyValueFactory property="glycemieFormatee" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Statut" prefWidth="120">
                <cellValueFactory>
                    <PropertyValueFactory property="statut" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Separator/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="CONSULTATION TERMINÉE" onAction="#terminerConsultation" styleClass="button-success" />
        <Button text="NOUVEAU PATIENT" onAction="#nouveauPatient" styleClass="button-primary" />
        <Button text="TABLEAU DE BORD" onAction="#voirTableauBord" styleClass="button-secondary" />
        <Button text="RETOUR" onAction="#retourAccueil" styleClass="button-secondary" />
    </HBox>

    <Label fx:id="lblStatistiques" styleClass="label-subtitle"/>
</VBox>